# Copy this file to `.env.local` and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Public anon key. Safe to expose in the browser: access is enforced by
# Row Level Security policies on every table. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=
